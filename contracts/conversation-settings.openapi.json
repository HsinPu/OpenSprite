{
  "openapi": "3.1.0",
  "info": {
    "title": "OpenSprite local conversation settings API",
    "version": "0.2.0-draft",
    "description": "Authoritative HTTP contract for persisted startup, message sending, chat auto-scroll and execution-panel default behavior."
  },
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "security": [],
  "x-transport-security": {
    "scope": "loopback-only local desktop service",
    "applicationAuthentication": "none",
    "browserOriginPolicy": "same-origin",
    "cors": "disabled by default"
  },
  "x-compatibility": {
    "policy": "This independent resource does not alter General Settings. Current on-disk schema v2 is read with executionPanelDefaultExpanded=false and the next successful PUT writes schema v3; older schemas remain unsupported."
  },
  "x-events": {"supported": false},
  "tags": [{"name": "conversation-settings", "description": "Persisted startup, message sending, chat auto-scroll and execution-panel default behavior."}],
  "paths": {
    "/api/settings/conversation": {
      "get": {
        "operationId": "getConversationSettings",
        "summary": "Read conversation settings",
        "tags": ["conversation-settings"],
        "responses": {
          "200": {"description": "The confirmed local conversation settings.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ConversationSettings"}}}},
          "503": {"$ref": "#/components/responses/SettingsStoreUnavailable"},
          "500": {"$ref": "#/components/responses/InternalError"}
        }
      },
      "put": {
        "operationId": "putConversationSettings",
        "summary": "Replace conversation settings atomically",
        "tags": ["conversation-settings"],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ConversationSettings"}}}},
        "responses": {
          "200": {"description": "The requested values are now confirmed.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ConversationSettings"}}}},
          "400": {"$ref": "#/components/responses/InvalidRequest"},
          "503": {"$ref": "#/components/responses/SettingsStoreUnavailable"},
          "500": {"$ref": "#/components/responses/InternalError"}
        }
      }
    }
  },
  "components": {
    "schemas": {
      "StartupView": {"type": "string", "enum": ["new", "recent"]},
      "SendBehavior": {"type": "string", "enum": ["enter", "modifier-enter"]},
      "ConversationSettings": {
        "type": "object",
        "additionalProperties": false,
        "required": ["startupView", "sendBehavior", "autoScroll", "executionPanelDefaultExpanded"],
        "properties": {
          "startupView": {"$ref": "#/components/schemas/StartupView"},
          "sendBehavior": {"$ref": "#/components/schemas/SendBehavior"},
          "autoScroll": {"type": "boolean"},
          "executionPanelDefaultExpanded": {"type": "boolean"}
        }
      },
      "ErrorCode": {"type": "string", "enum": ["invalid_request", "settings_store_unavailable", "internal_error"]},
      "ErrorDetail": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message", "retryable"],
        "properties": {
          "code": {"$ref": "#/components/schemas/ErrorCode"},
          "message": {"type": "string"},
          "retryable": {"type": "boolean"}
        }
      },
      "ErrorEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": ["error"],
        "properties": {"error": {"$ref": "#/components/schemas/ErrorDetail"}}
      }
    },
    "responses": {
      "InvalidRequest": {"description": "Malformed or noncanonical conversation settings.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorEnvelope"}}}},
      "SettingsStoreUnavailable": {"description": "The local conversation settings file is unavailable.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorEnvelope"}}}},
      "InternalError": {"description": "An unexpected local backend error occurred.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorEnvelope"}}}}
    }
  }
}
