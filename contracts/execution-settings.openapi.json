{
  "openapi": "3.1.0",
  "info": {
    "title": "OpenSprite local execution settings API",
    "version": "0.1.0-draft",
    "description": "Select one trusted installed Agent Loop using API v4. Import and Docker bundles are defined in execution-plugin-packages.openapi.json."
  },
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "security": [
    {
      "LocalSession": []
    }
  ],
  "x-transport-security": {
    "scope": "local desktop service",
    "applicationAuthentication": "existing local session policy; trusted-local mode may bypass login",
    "browserOriginPolicy": "same-origin",
    "cors": "disabled by default"
  },
  "x-persistence": {
    "path": ".opensprite/config/execution.json",
    "schemaVersion": 2,
    "default": {
      "pluginId": "standard"
    },
    "lazyCreation": "Absent settings stay implicit until PUT. Reading known v1 built-in pairs atomically migrates once; external pairs remain intact until explicit selection.",
    "revision": "Revision 0 denotes absent settings or an external v1 pair. PUT requires expectedRevision and increments it."
  },
  "x-execution-selection": "One plugin ID and version per accepted Run, persisted atomically with admission. Replays use the original profile. Unavailable saved IDs remain visible; external v1 pairs block new Runs until explicit API v4 selection. Historical API v2/v3 events remain readable.",
  "x-trust": "Discovery, GET and PUT inspect metadata only. The selected factory is loaded at Run admission and creates one fresh complete plugin per Run. Trusted plugins execute in-process with backend privileges.",
  "tags": [
    {
      "name": "execution-settings",
      "description": "Single Agent Loop selection."
    }
  ],
  "paths": {
    "/api/settings/execution": {
      "get": {
        "operationId": "getExecutionSettings",
        "summary": "Read saved selection and plugin metadata",
        "tags": [
          "execution-settings"
        ],
        "responses": {
          "200": {
            "description": "Selection and installed plugin metadata. A saved ID may no longer be listed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExecutionSettings"
                }
              }
            }
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      },
      "put": {
        "operationId": "putExecutionSettings",
        "summary": "Validate and replace execution selection atomically",
        "tags": [
          "execution-settings"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PutExecutionSettingsRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The requested selection is persisted and confirmed with current metadata.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExecutionSettings"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "409": {
            "$ref": "#/components/responses/RevisionConflict"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "LocalSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-OpenSpriteSession"
      }
    },
    "schemas": {
      "PluginId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
      },
      "ExecutionSelection": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pluginId"
        ],
        "properties": {
          "pluginId": {
            "$ref": "#/components/schemas/PluginId"
          }
        }
      },
      "ExecutionPlugin": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "description",
          "version",
          "apiVersion",
          "status"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/PluginId"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "description": {
            "type": "string",
            "maxLength": 2048
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "apiVersion": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "available",
              "incompatible",
              "unavailable"
            ]
          }
        }
      },
      "ExecutionSettings": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "selection",
          "revision",
          "migration",
          "plugins"
        ],
        "properties": {
          "selection": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ExecutionSelection"
              },
              {
                "type": "null"
              }
            ]
          },
          "plugins": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExecutionPlugin"
            },
            "description": "Unique plugin IDs. Available plugins implement API v4."
          },
          "migration": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/LegacySelection"
              },
              {
                "type": "null"
              }
            ]
          },
          "revision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "description": "selection is null exactly when migration is present; migration always has revision 0."
      },
      "ErrorCode": {
        "type": "string",
        "enum": [
          "invalid_request",
          "plugin_unavailable",
          "settings_store_unavailable",
          "internal_error",
          "revision_conflict",
          "migration_required"
        ]
      },
      "ErrorDetail": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message",
          "retryable"
        ],
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "message": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          }
        }
      },
      "ErrorEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        }
      },
      "PutExecutionSettingsRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pluginId",
          "expectedRevision"
        ],
        "properties": {
          "pluginId": {
            "$ref": "#/components/schemas/PluginId"
          },
          "expectedRevision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        }
      },
      "LegacySelection": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "loopId",
          "policyId"
        ],
        "properties": {
          "loopId": {
            "$ref": "#/components/schemas/PluginId"
          },
          "policyId": {
            "$ref": "#/components/schemas/PluginId"
          }
        },
        "description": "Inert migration information, never an executable selection."
      }
    },
    "responses": {
      "InvalidRequest": {
        "description": "Malformed fields or unknown plugin ID. error.code=invalid_request; retryable=false.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        }
      },
      "Unavailable": {
        "description": "An incompatible, unavailable or failing selected plugin (plugin_unavailable), or unreadable/unwritable settings (settings_store_unavailable). retryable=true.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        }
      },
      "InternalError": {
        "description": "An unexpected backend failure. error.code=internal_error; retryable=false.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        }
      },
      "RevisionConflict": {
        "description": "Settings changed; reload before applying. error.code=revision_conflict; retryable=false.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        }
      }
    }
  }
}
