{
  "openapi": "3.1.0",
  "info": {"title": "OpenSprite Tool approvals API", "version": "0.1.0-draft", "description": "Short-lived single-use approval for consequential MCP Tool calls."},
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "security": [],
  "x-transport-security": {"scope": "loopback-only local desktop service", "browserOriginPolicy": "same-origin", "cors": "disabled by default"},
  "paths": {
    "/api/tool-approvals/{approval_id}": {
      "parameters": [{"name": "approval_id", "in": "path", "required": true, "schema": {"$ref": "#/components/schemas/Identifier"}}],
      "get": {"operationId": "getToolApproval", "responses": {"200": {"description": "Pending approval with exact transient arguments", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ToolApprovalDetail"}}}}, "404": {"$ref": "#/components/responses/NotFound"}, "409": {"$ref": "#/components/responses/Expired"}}},
      "put": {"operationId": "putToolApprovalDecision", "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false, "required": ["decision"], "properties": {"decision": {"type": "string", "enum": ["allow_once", "deny"]}}}}}}, "responses": {"200": {"description": "Recorded single-use decision", "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false, "required": ["id", "decision"], "properties": {"id": {"$ref": "#/components/schemas/Identifier"}, "decision": {"type": "string", "enum": ["allow_once", "deny"]}}}}}, "400": {"$ref": "#/components/responses/InvalidRequest"}, "404": {"$ref": "#/components/responses/NotFound"}, "409": {"$ref": "#/components/responses/Expired"}}}}
    }
  },
  "components": {
    "schemas": {
      "Identifier": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
      "ToolApprovalDetail": {"type": "object", "additionalProperties": false, "required": ["id", "runId", "conversationId", "toolId", "toolName", "serverId", "arguments", "argumentHash", "createdAt", "expiresAt"], "properties": {"id": {"$ref": "#/components/schemas/Identifier"}, "runId": {"$ref": "#/components/schemas/Identifier"}, "conversationId": {"$ref": "#/components/schemas/Identifier"}, "toolId": {"type": "string"}, "toolName": {"type": "string"}, "serverId": {"$ref": "#/components/schemas/Identifier"}, "arguments": {"type": "object"}, "argumentHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "createdAt": {"type": "string", "format": "date-time"}, "expiresAt": {"type": "string", "format": "date-time"}}},
      "ErrorCode": {"type": "string", "enum": ["invalid_request", "not_found", "approval_expired", "approval_already_decided", "database_unavailable", "internal_error"]},
      "ErrorEnvelope": {"type": "object", "additionalProperties": false, "required": ["error"], "properties": {"error": {"type": "object", "additionalProperties": false, "required": ["code", "message", "retryable"], "properties": {"code": {"$ref": "#/components/schemas/ErrorCode"}, "message": {"type": "string"}, "retryable": {"type": "boolean"}}}}}
    },
    "responses": {
      "InvalidRequest": {"description": "Invalid decision", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorEnvelope"}}}},
      "NotFound": {"description": "Approval not found", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorEnvelope"}}}},
      "Expired": {"description": "Approval expired or already decided", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorEnvelope"}}}}
    }
  }
}
