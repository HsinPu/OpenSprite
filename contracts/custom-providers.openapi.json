  "openapi": "3.1.0",
  "info": {
    "title": "OpenSprite Custom Providers",
    "version": "0.21.0",
    "description": "Custom OpenAI-compatible Chat Completions providers. Builtin provider IDs and connection operations remain defined by provider-connections.openapi.json. Mutations reject unknown and duplicate JSON fields. Endpoint/auth and model mutation are blocked during live use; deletion also checks saved settings, schedules and registered Agents. Credentials are write-only and encrypted at rest. Empty/omitted API keys on edit preserve the existing key; no-auth removes it. Discovery uses GET <baseUrl>/models without redirects and commits only after revision/reference checks."
  },
