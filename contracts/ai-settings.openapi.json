{
  "openapi": "3.1.0",
  "info": {
    "title": "OpenSprite local AI settings API",
    "version": "0.7.0-draft",
    "description": "Authoritative HTTP contract for one atomic local model selection, context budget, output budget, bounded output continuation, response delivery preference, full prompt logging preference and response mode setting."
  },
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "security": [],
  "x-transport-security": {
    "scope": "loopback-only local desktop service",
    "applicationAuthentication": "none",
    "browserOriginPolicy": "same-origin",
    "cors": "disabled by default",
    "requirements": [
      "Runtime and installer configurations must bind only to loopback addresses.",
      "Deployments must reject non-loopback Host values and cross-origin browser mutations before AI settings routes become operational."
    ]
  },
  "x-compatibility": {
    "policy": "This rebuild is new-install-only. The removed model-only route and schema are intentionally unsupported."
  },
  "x-events": {
    "supported": false,
    "description": "This contract defines no event, webhook, or WebSocket delivery behavior."
  },
  "tags": [
    {
      "name": "ai-settings",
      "description": "One atomic local model selection, response mode and response delivery setting."
    }
  ],
  "paths": {
    "/api/settings/ai/response-mode": {
      "get": {
        "operationId": "resolveResponseMode",
        "tags": [
          "ai-settings"
        ],
        "description": "Read-only preview using the same capability resolution as execution. Does not save preferences or invoke inference. Unknown capabilities return status unknown and effective null.",
        "parameters": [
          {
            "in": "query",
            "name": "providerId",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ProviderId"
            }
          },
          {
            "in": "query",
            "name": "modelId",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          {
            "in": "query",
            "name": "responseMode",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ResponseMode"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Resolved native reasoning effort.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReasoningResolution"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "503": {
            "$ref": "#/components/responses/SettingsOrCredentialStoreUnavailable"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/api/settings/ai/providers/{provider_id}/tools": {
      "put": {"operationId":"putProviderToolPolicy","summary":"Update one native provider tool policy atomically","parameters":[{"name":"provider_id","in":"path","required":true,"schema":{"type":"string","enum":["openai","anthropic","openrouter"]}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ProviderToolPolicy"}}}},"responses":{"200":{"description":"Policy saved; other preferences preserved","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AiSettings"}}}},"400":{"$ref":"#/components/responses/InvalidRequest"},"503":{"$ref":"#/components/responses/SettingsStoreUnavailable"},"500":{"$ref":"#/components/responses/InternalError"}}}
    },
    "/api/settings/ai": {
      "get": {
        "operationId": "getAiSettings",
        "summary": "Read AI settings",
        "description": "Returns a null model, default response mode, five output continuations and stream response delivery when no settings file exists. The read is side-effect free.",
        "tags": ["ai-settings"],
        "responses": {
          "200": {
            "description": "The confirmed local AI settings.",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AiSettings"}}}
          },
          "503": {"$ref": "#/components/responses/SettingsStoreUnavailable"},
          "500": {"$ref": "#/components/responses/InternalError"}
        }
      },
      "put": {
        "operationId": "putAiSettings",
        "summary": "Replace AI settings atomically",
        "description": "A non-null model requires a currently connected Provider. A null model preserves and persists the supplied response mode.",
        "tags": ["ai-settings"],
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AiSettings"}}}
        },
        "responses": {
          "200": {
            "description": "The requested values are now the confirmed local AI settings.",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AiSettings"}}}
          },
          "400": {"$ref": "#/components/responses/InvalidRequest"},
          "409": {"$ref": "#/components/responses/NotConnected"},
          "503": {"$ref": "#/components/responses/SettingsOrCredentialStoreUnavailable"},
          "500": {"$ref": "#/components/responses/InternalError"}
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ReasoningResolution": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requested",
          "effective",
          "status"
        ],
        "properties": {
          "requested": {
            "type": "string",
            "enum": [
              "default",
              "low",
              "medium",
              "high",
              "xhigh",
              "max",
              "ultra"
            ]
          },
          "effective": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              null,
              "none",
              "minimal",
              "low",
              "medium",
              "high",
              "xhigh",
              "max"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "exact",
              "fallback",
              "provider_default",
              "unknown"
            ]
          }
        }
      },
      "ProviderToolPolicy": {"type":"object","additionalProperties":false,"properties":{"toolsEnabled":{"type":"boolean","default":true},"transport":{"type":"string","enum":["stream","non_streaming"],"default":"stream"},"disabledModels":{"type":"array","maxItems":1000,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":256},"default":[]}}},
      "ProviderId": {"type": "string", "pattern": "^(?:openai|anthropic|openrouter|[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12})$"},
      "ResponseMode": {
        "type": "string",
        "enum": [
          "default",
          "low",
          "medium",
          "high",
          "xhigh",
          "max",
          "ultra"
        ],
        "description": "Requested reasoning preference. default omits the reasoning effort parameter and uses provider defaults; it does not force reasoning off. Unsupported levels use the highest supported native effort; ultra is resolved to the highest available effort. Unknown or unavailable effort control omits the provider parameter."
      },
      "ResponseDelivery": {"type": "string", "enum": ["stream", "complete"], "description": "stream displays assistant deltas as they arrive; complete displays the assembled response after the Run reaches a terminal state."},
      "OutputContinuation": {"type": "string", "enum": ["off", "1", "2", "3", "5", "10", "20", "50", "unlimited"]},
      "ModelSelection": {
        "type": "object",
        "additionalProperties": false,
        "required": ["providerId", "modelId", "contextBudget", "outputBudget"],
        "properties": {
          "providerId": {"$ref": "#/components/schemas/ProviderId"},
          "modelId": {"type": "string", "minLength": 1, "maxLength": 256},
          "contextBudget": {
            "type": "string",
            "enum": ["auto", "32k", "64k", "128k", "256k", "max"],
            "description": "OpenSprite context-use ceiling for this model selection; max still reserves output and safety space."
          },
          "outputBudget": {
            "type": "string",
            "enum": ["auto", "8k", "16k", "32k", "64k", "max"],
            "description": "Requested response-token budget; the backend still caps it to the selected model and safe Context capacity."
          }
        }
      },
      "AiSettings": {
        "type": "object",
        "additionalProperties": false,
        "required": ["model", "responseMode", "outputContinuation", "responseDelivery", "logFullPrompts"],
        "properties": {
          "model": {"anyOf": [{"$ref": "#/components/schemas/ModelSelection"}, {"type": "null"}]},
          "responseMode": {"$ref": "#/components/schemas/ResponseMode"},
          "outputContinuation": {"$ref": "#/components/schemas/OutputContinuation"},
          "responseDelivery": {"$ref": "#/components/schemas/ResponseDelivery"},
          "logFullPrompts": {"type": "boolean", "description": "Whether complete model request messages are written to local per-request Prompt logs."},
          "providerToolPolicies": {"type":"object","additionalProperties":false,"description":"Native provider policies. Omitted on general PUT preserves current policies.","properties":{"openai":{"$ref":"#/components/schemas/ProviderToolPolicy"},"anthropic":{"$ref":"#/components/schemas/ProviderToolPolicy"},"openrouter":{"$ref":"#/components/schemas/ProviderToolPolicy"}}}
        }
      },
      "ErrorCode": {
        "type": "string",
        "enum": ["invalid_request", "not_connected", "credential_store_unavailable", "settings_store_unavailable", "internal_error"]
      },
      "ErrorDetail": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message", "retryable"],
        "properties": {
          "code": {"$ref": "#/components/schemas/ErrorCode"},
          "message": {"type": "string"},
          "retryable": {"type": "boolean"}
        }
      },
      "ErrorEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": ["error"],
        "properties": {"error": {"$ref": "#/components/schemas/ErrorDetail"}}
      }
    },
    "responses": {
      "InvalidRequest": {"description": "Malformed or noncanonical AI settings.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorEnvelope"}}}},
      "NotConnected": {"description": "The selected Provider is not connected.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorEnvelope"}}}},
      "SettingsStoreUnavailable": {"description": "The local AI settings file is unavailable.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorEnvelope"}}}},
      "SettingsOrCredentialStoreUnavailable": {"description": "AI settings or Provider state could not be safely accessed.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorEnvelope"}}}},
      "InternalError": {"description": "An unexpected local backend error occurred.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorEnvelope"}}}}
    }
  }
}
