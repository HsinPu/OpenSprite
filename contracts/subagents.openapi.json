{
  "openapi": "3.1.0",
  "info": {
    "title": "OpenSprite Subagent inspection API",
    "version": "0.1.0-draft",
    "description": "Authenticated inspection and cancellation of bounded child-Agent executions."
  },
  "security": [{"cookieSession": []}],
  "paths": {
    "/api/runs/{parent_id}/agents": {
      "get": {
        "tags": ["subagents"],
        "operationId": "listSubagents",
        "parameters": [{
          "name": "parent_id",
          "in": "path",
          "required": true,
          "schema": {"type": "string", "format": "uuid"}
        }],
        "responses": {
          "200": {"description": "Child executions owned by the parent run.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SubagentList"}}}},
          "400": {"$ref": "#/components/responses/InvalidRequest"},
          "401": {"$ref": "#/components/responses/AuthenticationRequired"},
          "404": {"$ref": "#/components/responses/NotFound"},
          "409": {"$ref": "#/components/responses/Conflict"},
          "503": {"$ref": "#/components/responses/Unavailable"}
        }
      }
    },
    "/api/runs/{parent_id}/agents/{child_id}": {
      "get": {
        "tags": ["subagents"],
        "operationId": "getSubagentResult",
        "parameters": [
          {"name": "parent_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}},
          {"name": "child_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}},
          {"name": "offset", "in": "query", "required": false, "schema": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807, "default": 0}}
        ],
        "responses": {
          "200": {"description": "A bounded page of the child result.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SubagentResult"}}}},
          "400": {"$ref": "#/components/responses/InvalidRequest"},
          "401": {"$ref": "#/components/responses/AuthenticationRequired"},
          "404": {"$ref": "#/components/responses/NotFound"},
          "409": {"$ref": "#/components/responses/Conflict"},
          "503": {"$ref": "#/components/responses/Unavailable"}
        }
      }
    },
    "/api/runs/{parent_id}/agents/{child_id}/cancel": {
      "post": {
        "tags": ["subagents"],
        "operationId": "cancelSubagent",
        "parameters": [
          {"name": "parent_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}},
          {"name": "child_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}
        ],
        "responses": {
          "200": {"description": "The terminal or newly cancelled child execution.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SubagentSummary"}}}},
          "400": {"$ref": "#/components/responses/InvalidRequest"},
          "401": {"$ref": "#/components/responses/AuthenticationRequired"},
          "404": {"$ref": "#/components/responses/NotFound"},
          "409": {"$ref": "#/components/responses/Conflict"},
          "503": {"$ref": "#/components/responses/Unavailable"}
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SubagentStatus": {"type": "string", "enum": ["queued", "running", "cancelling", "completed", "failed", "cancelled", "interrupted", "timed_out"]},
      "ProviderId": {"type": "string", "enum": ["openai", "anthropic", "openrouter"]},
      "SubagentSummary": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "parentRunId", "agentId", "name", "revision", "providerId", "modelId", "status", "errorCode", "createdAt", "startedAt", "finishedAt"],
        "properties": {
          "id": {"type": "string", "format": "uuid"},
          "parentRunId": {"type": "string", "format": "uuid"},
          "agentId": {"type": "string", "format": "uuid"},
          "name": {"type": "string", "minLength": 1, "maxLength": 80},
          "revision": {"type": "integer", "minimum": 1},
          "providerId": {"$ref": "#/components/schemas/ProviderId"},
          "modelId": {"type": "string", "minLength": 1, "maxLength": 256},
          "status": {"$ref": "#/components/schemas/SubagentStatus"},
          "errorCode": {"anyOf": [{"type": "string", "pattern": "^[a-z][a-z0-9_]{0,79}$", "maxLength": 80}, {"type": "null"}]},
          "createdAt": {"type": "string", "format": "date-time"},
          "startedAt": {"anyOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]},
          "finishedAt": {"anyOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]}
        }
      },
      "SubagentList": {
        "type": "object",
        "additionalProperties": false,
        "required": ["items"],
        "properties": {"items": {"type": "array", "maxItems": 6, "items": {"$ref": "#/components/schemas/SubagentSummary"}}}
      },
      "SubagentResult": {
        "type": "object",
        "additionalProperties": false,
        "required": ["childId", "status", "error", "text", "nextOffset"],
        "properties": {
          "childId": {"type": "string", "format": "uuid"},
          "status": {"$ref": "#/components/schemas/SubagentStatus"},
          "error": {"anyOf": [{"type": "string", "maxLength": 512}, {"type": "null"}]},
          "text": {"type": "string", "maxLength": 4000},
          "nextOffset": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]}
        }
      },
      "AgentErrorDetail": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message", "retryable"],
        "properties": {"code": {"type": "string"}, "message": {"type": "string"}, "retryable": {"type": "boolean"}}
      },
      "AgentErrorResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["error"],
        "properties": {"error": {"$ref": "#/components/schemas/AgentErrorDetail"}}
      }
    },
    "responses": {
      "InvalidRequest": {"description": "Invalid request.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AgentErrorResponse"}}}},
      "AuthenticationRequired": {"description": "Authentication required.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AgentErrorResponse"}}}},
      "NotFound": {"description": "Parent run or child execution not found.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AgentErrorResponse"}}}},
      "Conflict": {"description": "Child execution conflict.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AgentErrorResponse"}}}},
      "Unavailable": {"description": "Child execution store unavailable.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AgentErrorResponse"}}}}
    },
    "securitySchemes": {"cookieSession": {"type": "apiKey", "in": "cookie", "name": "opensprite_session"}}
  }
}
